{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch(domain:third-shot.vercel.app)",
      "WebFetch(domain:*.vercel.app)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(file:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(tree:*)",
      "Bash(curl -s https://third-shot.vercel.app:*)",
      "Bash(curl -sI https://third-shot.vercel.app:*)",
      "Bash(curl -sS https://third-shot.vercel.app:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git push -u origin claude/:*)",

      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(npm run build:frontend)",
      "Bash(npm ci)",
      "Bash(npx playwright test:*)",
      "Bash(node scripts/build_frontend_assets.mjs)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(rm -rf:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
