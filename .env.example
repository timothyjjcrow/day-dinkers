APP_ENV=development
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///app.db
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=2592000
JWT_REFRESH_AFTER_SECONDS=604800
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Third Shot
# Business credentials stay disabled unless this is `hybrid` or `encrypted_sql`.
BUSINESS_CREDENTIAL_VAULT=disabled
# Generate a separate Fernet key; never reuse SECRET_KEY or commit a real key.
BUSINESS_CREDENTIAL_ENCRYPTION_KEY=
BUSINESS_CREDENTIAL_KEY_VERSION=1
# Exact Bearer secret shared by every authenticated /api/cron/* route.
CRON_SECRET=
BUSINESS_INTEGRATION_CRON_LIMIT=40
# Stop accepting new cron work before the 60-second function limit.
BUSINESS_INTEGRATION_CRON_TIME_BUDGET_SECONDS=45
# Recheck daily while retaining last-known-good evidence across a delayed run.
BUSINESS_LINK_HEALTH_RECHECK_HOURS=20
BUSINESS_LINK_HEALTH_VALID_HOURS=72
BUSINESS_CATALOG_PULL_INTERVAL_MINUTES=1200
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=Third Shot <business@example.com>
PUBLIC_APP_URL=https://third-shot.vercel.app
LOG_LEVEL=INFO
PORT=8000
AUTO_CREATE_DB=true
AUTO_SEED_COURTS=false
SCHEMA_MANAGEMENT_ENABLED=true
SERVERLESS_RUNTIME=false
# Exact court presence expires when no heartbeat arrives for 30 minutes.
PRESENCE_STALE_AFTER_SECONDS=1800
TOURNAMENT_RESULT_AUTO_CONFIRM_HOURS=2
LEAGUE_RESULT_AUTO_CONFIRM_HOURS=24
COMPETITION_RESULT_NUDGE_COOLDOWN_MINUTES=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
PUSH_DELIVERY_ENABLED=true
# Generate one VAPID key pair and keep the private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:ops@example.com
